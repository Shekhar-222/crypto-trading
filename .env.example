# Telegram is off by default and alerts only go to the logs column on the page.
# To turn it on, copy this file to .env, set TELEGRAM_ENABLED=true and fill in both values.
# Never share .env.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed for PnL updates. Strike alerts use public data.
DELTA_API_KEY=
DELTA_API_SECRET=
