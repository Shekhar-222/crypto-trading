# Telegram is off by default and alerts only go to the logs column on the page.
# To turn it on, copy this file to .env, set TELEGRAM_ENABLED=true and fill in both values.
# Never share .env.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed for PnL updates. Strike alerts use public data.
DELTA_API_KEY=
DELTA_API_SECRET=

# Leave both empty to keep the page on this machine only. With both set, the page also opens at
# http://PUBLIC_HOST:8765/?key=DASHBOARD_KEY, so make the key long and random and never share it.
PUBLIC_HOST=
DASHBOARD_KEY=
